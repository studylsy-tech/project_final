<?xml version="1.0"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.dao.MemberMapper">
    
    <resultMap id="MemberResultMap" type="com.project.model.MemberDTO">
        <result property="phone" column="PHONE" />
        <result property="pw" column="PW" />
        <result property="name" column="NAME" />
        <result property="nickname" column="NICKNAME" />
        <result property="email" column="EMAIL" />
        <result property="address" column="ADDRESS" />
        <result property="memberType" column="MEMBER_TYPE" />
        <result property="createdAt" column="CREATED_AT" />
    </resultMap>
    
    <insert id="insertSemiMember" parameterType="com.project.model.MemberDTO">
        INSERT INTO MEMBERS (
            PHONE, PW, EMAIL, MEMBER_TYPE, CREATED_AT
        ) VALUES (
            #{phone}, 
            #{pw}, 
            #{email, jdbcType=VARCHAR}, 
            1, 
            SYSDATE
        )
    </insert>
    
    <insert id="insertFull" parameterType="com.project.model.MemberDTO">
        INSERT INTO MEMBERS (
            PHONE, 
            PW, 
            NAME, 
            NICKNAME, 
            EMAIL, 
            ADDRESS, 
            MEMBER_TYPE
        ) VALUES (
            #{phone}, 
            #{pw}, 
            #{name}, 
            #{nickname}, 
            #{email}, 
            #{address}, 
            2
        )
    </insert>
    
    <select id="loginCheck" parameterType="com.project.model.MemberDTO" resultMap="MemberResultMap">
        SELECT * FROM MEMBERS WHERE PHONE = #{phone} AND PW = #{pw}
    </select>
  
    <update id="updateMember" parameterType="com.project.model.MemberDTO">
        UPDATE MEMBERS 
        SET 
            PW = #{pw}
            <if test="memberType == 2 or memberType == 0">
                , NAME = #{name}
                , NICKNAME = #{nickname}
                , ADDRESS = #{address}
            </if>
        WHERE EMAIL = #{email}
    </update>
    
    <delete id="deleteMember" parameterType="string">
        DELETE FROM MEMBERS WHERE PHONE = #{phone}
    </delete>

    <select id="getTotalMemberCount" resultType="int">
        SELECT COUNT(*) FROM MEMBERS
    </select>

    <select id="selectAllMembers" resultMap="MemberResultMap">
        SELECT 
            PHONE, 
            PW, 
            NAME, 
            NICKNAME, 
            EMAIL, 
            ADDRESS, 
            MEMBER_TYPE, 
            CREATED_AT 
        FROM MEMBERS 
        ORDER BY CREATED_AT DESC
    </select>

</mapper>